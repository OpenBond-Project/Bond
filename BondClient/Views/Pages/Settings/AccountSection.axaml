<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Bond.ViewModels"
             x:Class="Bond.Views.Pages.Settings.AccountSection"
             x:DataType="vm:SettingsPageViewModel">

    <!-- task-142：从 SettingsPage 拆出的「账户与安全」分组（绑定名沿用原样） -->
    <StackPanel Spacing="14" HorizontalAlignment="Stretch">
        <!-- 账户与设备 -->
        <suki:GlassCard Background="{DynamicResource BondSurface}" BorderBrush="{DynamicResource BondBorder}" BorderThickness="1" IsOpaque="True" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Classes="h2" Text="设备" />

                <Grid ColumnDefinitions="200,*" Height="40">
                    <TextBlock Text="设备名称" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DeviceName}" Height="34" MinHeight="34"
                             VerticalContentAlignment="Center" />
                </Grid>

            </StackPanel>
        </suki:GlassCard>

        <!-- 修改密码（task-153）：三态反馈在行内，不弹窗、不强制登出 -->
        <suki:GlassCard Background="{DynamicResource BondSurface}" BorderBrush="{DynamicResource BondBorder}" BorderThickness="1" IsOpaque="True" Padding="18">
            <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="修改密码" />

                <Grid ColumnDefinitions="200,*" Height="40">
                    <TextBlock Text="当前密码" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PasswordOld}" PasswordChar="●"
                             Height="34" MinHeight="34" VerticalContentAlignment="Center"
                             PlaceholderText="当前密码"
                             AutomationProperties.Name="当前密码" />
                </Grid>

                <Grid ColumnDefinitions="200,*" Height="40">
                    <TextBlock Text="新密码" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PasswordNew}" PasswordChar="●"
                             Height="34" MinHeight="34" VerticalContentAlignment="Center"
                             PlaceholderText="至少 6 位"
                             AutomationProperties.Name="新密码" />
                </Grid>

                <Grid ColumnDefinitions="200,*" Height="40">
                    <TextBlock Text="确认新密码" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PasswordConfirm}" PasswordChar="●"
                             Height="34" MinHeight="34" VerticalContentAlignment="Center"
                             PlaceholderText="再输入一次新密码"
                             AutomationProperties.Name="确认新密码" />
                </Grid>

                <TextBlock Text="{Binding PasswordHint}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource BondError}"
                           IsVisible="{Binding PasswordHintIsError}" />
                <TextBlock Text="{Binding PasswordHint}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource BondSuccess}"
                           IsVisible="{Binding !PasswordHintIsError}" />

                <Button Classes="primary" HorizontalAlignment="Right" Padding="18,7"
                        Command="{Binding ChangePasswordCommand}"
                        IsEnabled="{Binding CanChangePassword}"
                        AutomationProperties.Name="修改密码">
                    <TextBlock Text="{Binding ChangePasswordButtonText}" FontSize="12.5"
                               Foreground="{DynamicResource BondOnAccent}" />
                </Button>
            </StackPanel>
        </suki:GlassCard>

        <suki:GlassCard Background="{DynamicResource BondSurface}" BorderBrush="{DynamicResource BondBorder}" BorderThickness="1" IsOpaque="True" Padding="18">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="退出登录" FontSize="12.5" FontWeight="Medium"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="soft" Padding="12,6" VerticalAlignment="Center"
                        ToolTip.Tip="需要二次确认">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="10" Width="220">
                                <TextBlock Text="确认退出当前账号？" FontSize="12.5" FontWeight="Medium" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="soft" Padding="10,5">
                                        <TextBlock Text="取消" FontSize="11.5" />
                                    </Button>
                                    <Button Classes="primary" Padding="10,5"
                                            Command="{Binding SignOutCommand}">
                                        <TextBlock Text="退出登录" FontSize="11.5" Foreground="{DynamicResource BondOnAccent}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Logout" IconSize="13"
                                         Foreground="{DynamicResource BondError}" />
                        <TextBlock Text="退出登录" FontSize="12"
                                   Foreground="{DynamicResource BondError}" />
                    </StackPanel>
                </Button>
            </Grid>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
