<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Bond.ViewModels"
             x:Class="Bond.Views.Pages.Settings.ProfileSection"
             x:DataType="vm:SettingsPageViewModel">

    <!-- 「我的」页个人资料卡：头像 / 昵称 / 会员徽标 / 邮箱 -->
    <StackPanel Spacing="14" HorizontalAlignment="Stretch">
        <suki:GlassCard Background="{DynamicResource BondSurface}" BorderBrush="{DynamicResource BondBorder}"
                        BorderThickness="1" IsOpaque="True" Padding="18">
            <StackPanel Spacing="12">

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <!-- 头像：悬浮显示遮罩 + 编辑图标，点击进入选图/裁切；上传中显示进度遮罩 -->
                    <Panel Width="80" Height="80" VerticalAlignment="Center" Classes="avatarhost">
                        <Button Width="80" Height="80" Padding="0" CornerRadius="40"
                                Background="Transparent" BorderThickness="0"
                                Click="OnChangeAvatarClick"
                                PointerEntered="OnAvatarPointerEntered"
                                PointerExited="OnAvatarPointerExited"
                                IsEnabled="{Binding CanEditAvatar}"
                                AutomationProperties.Name="更换头像">
                            <Panel>
                                <Border Width="80" Height="80" CornerRadius="40" ClipToBounds="True"
                                        Background="{DynamicResource BondAccentSoft}">
                                    <Panel>
                                        <Image Source="{Binding AvatarSource}" Stretch="UniformToFill"
                                               IsVisible="{Binding HasAvatar}" />
                                        <TextBlock Text="{Binding AccountInitial}" FontSize="30" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BondAccent}"
                                                   IsVisible="{Binding !HasAvatar}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <Border x:Name="AvatarOverlay" Classes="avataroverlay" Background="#73000000"
                                        CornerRadius="40" Opacity="0" IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                        <mi:MaterialIcon Kind="PencilOutline" IconSize="18" Foreground="White" />
                                        <TextBlock Text="更换" FontSize="10" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Button>
                        <Border IsVisible="{Binding IsUploadingAvatar}" Background="#B3000000" CornerRadius="40">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <ProgressBar IsIndeterminate="True" Width="42" Height="4" />
                                <TextBlock Text="上传中…" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsNicknameEditing}">
                            <TextBlock Text="{Binding AccountName}" FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource BondAccentSoft}" CornerRadius="9"
                                    Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlanNameText}" FontSize="10.5" FontWeight="Medium"
                                           Foreground="{DynamicResource BondAccent}" />
                            </Border>
                            <Button Classes="ghosticon" Padding="6" MinWidth="28" MinHeight="28"
                                    Command="{Binding BeginEditNicknameCommand}"
                                    ToolTip.Tip="编辑昵称"
                                    AutomationProperties.Name="编辑昵称">
                                <mi:MaterialIcon Kind="PencilOutline" IconSize="14" />
                            </Button>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsNicknameEditing}"
                              Margin="0,2,0,0">
                            <TextBox Text="{Binding ProfileNickname, Mode=TwoWay}" Classes="input"
                                     Height="34" MaxLength="24" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="昵称"
                                     IsEnabled="{Binding !IsSavingProfile}" />
                            <Button Grid.Column="1" Classes="soft" Margin="8,0,0,0" MinWidth="88"
                                    Command="{Binding SaveProfileCommand}"
                                    IsEnabled="{Binding CanSaveProfile}"
                                    AutomationProperties.Name="保存昵称">
                                <TextBlock Text="{Binding SaveProfileButtonText}" FontSize="12.5" />
                            </Button>
                            <Button Grid.Column="2" Classes="soft" Margin="8,0,0,0" MinWidth="60"
                                    Command="{Binding CancelEditNicknameCommand}"
                                    IsEnabled="{Binding !IsSavingProfile}"
                                    AutomationProperties.Name="取消编辑昵称">
                                <TextBlock Text="取消" FontSize="12.5" />
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Classes="meta" Text="{Binding EmailDisplay}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Classes="ghosticon" Padding="6" MinWidth="28" MinHeight="28"
                                    Command="{Binding OpenEmailChangeCommand}"
                                    ToolTip.Tip="修改邮箱" AutomationProperties.Name="修改邮箱">
                                <mi:MaterialIcon Kind="PencilOutline" IconSize="14" />
                            </Button>
                        </StackPanel>

                        <Border IsVisible="{Binding IsEmailChangeOpen}"
                                Background="{DynamicResource BondSurfaceAlt}" CornerRadius="10"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <StackPanel IsVisible="{Binding !IsEmailConfirmStep}" Spacing="8">
                                    <TextBox Text="{Binding CurrentPassword}" PasswordChar="●"
                                             Height="34" MinHeight="34" PlaceholderText="当前密码"
                                             VerticalContentAlignment="Center" FontSize="12" />
                                    <TextBox Text="{Binding NewEmail}" Height="34" MinHeight="34"
                                             PlaceholderText="新邮箱地址"
                                             VerticalContentAlignment="Center" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Padding="14,6"
                                                Command="{Binding RequestEmailChangeCommand}"
                                                Content="发送验证码" />
                                        <Button Classes="outline" Padding="14,6"
                                                Command="{Binding CancelEmailChangeCommand}"
                                                Content="取消" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsEmailConfirmStep}" Spacing="8">
                                    <TextBox Text="{Binding EmailChangeCode}" MaxLength="6"
                                             Height="34" MinHeight="34" PlaceholderText="6 位验证码"
                                             VerticalContentAlignment="Center" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Padding="14,6"
                                                Command="{Binding ConfirmEmailChangeCommand}"
                                                Content="确认修改" />
                                        <Button Classes="outline" Padding="14,6"
                                                Command="{Binding CancelEmailChangeCommand}"
                                                Content="取消" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding EmailChangeHint}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource BondSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 头像操作的提示行（成功 / 失败原文 + 失败重试） -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAvatarHint}">
                    <Panel>
                        <TextBlock Classes="meta" Text="{Binding AvatarHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BondError}"
                                   IsVisible="{Binding AvatarHintIsError}" />
                        <TextBlock Classes="meta" Text="{Binding AvatarHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BondSuccess}"
                                   IsVisible="{Binding !AvatarHintIsError}" />
                    </Panel>
                    <Button Grid.Column="1" Classes="soft" MinHeight="32" Padding="14,0" Margin="10,0,0,0"
                            Command="{Binding RetryAvatarCommand}"
                            IsVisible="{Binding AvatarRetryVisible}"
                            AutomationProperties.Name="重试上传头像">
                        <TextBlock Text="重试" FontSize="12.5" />
                    </Button>
                </Grid>

                <Panel IsVisible="{Binding HasProfileHint}">
                    <TextBlock Classes="meta" Text="{Binding ProfileHint}"
                               Foreground="{DynamicResource BondError}"
                               IsVisible="{Binding ProfileHintIsError}" TextWrapping="Wrap" />
                    <TextBlock Classes="meta" Text="{Binding ProfileHint}"
                               Foreground="{DynamicResource BondSuccess}"
                               IsVisible="{Binding !ProfileHintIsError}"
                               TextWrapping="Wrap" />
                </Panel>

            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
